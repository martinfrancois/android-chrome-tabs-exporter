{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "reviewers": [
    "martinfrancois"
  ],
  "rangeStrategy": "replace",
  "separateMinorPatch": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "groupName": "Apache POI",
      "matchPackageNames": [
        "org.apache.poi{/,}**"
      ]
    },
    {
      "groupName": "Logging",
      "matchPackageNames": [
        "org.apache.logging{/,}**",
        "org.slf4j{/,}**"
      ]
    },
    {
      "groupName": "Testing",
      "matchPackageNames": [
        "org.junit{/,}**",
        "org.assertj{/,}**"
      ]
    }
  ]
}
