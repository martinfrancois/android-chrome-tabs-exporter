{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs"
  ],
  "labels": [
    "dependencies"
  ],
  "automergeType": "pr",
  "ignoreTests": false,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "pinDigests": true,
  "platformAutomerge": false,
  "rangeStrategy": "pin",
  "dependencyDashboardApproval": false,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMinorPatch": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [],
    "updateNotScheduled": true,
    "groupName": null,
    "groupSlug": null
  },
  "packageRules": [
    {
      "description": "Merge eligible non-major updates after checks pass; keep unrelated dependencies separate.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major update"
      ],
      "description": "Major updates require human review."
    },
    {
      "description": "jSystemThemeDetector links against oshi-core at class initialisation time and both exclude the stock jna in favour of jna-jpms, so the three move together and get a launch check instead of automerge.",
      "matchPackageNames": [
        "com.github.oshi{/,}**",
        "com.github.Dansoftowner{/,}**",
        "net.java.dev.jna{/,}**"
      ],
      "groupName": "Native platform stack",
      "groupSlug": "native-platform",
      "automerge": false,
      "addLabels": [
        "needs launch check"
      ]
    },
    {
      "description": "oshi-core 7 removed SystemInfo.getCurrentPlatform(), which jSystemThemeDetector 3.9.1 still calls. OsThemeDetectorLaunchTest fails against 7.x. Remove the cap once a jSystemThemeDetector release declares oshi-core 7.",
      "matchPackageNames": [
        "com.github.oshi{/,}**"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "poi and poi-ooxml share a release train and must move together.",
      "matchPackageNames": [
        "org.apache.poi{/,}**"
      ],
      "groupName": "Apache POI",
      "groupSlug": "apache-poi"
    },
    {
      "description": "Logging facade and backend must move together; a mismatched pair fails at runtime rather than at compile time.",
      "matchPackageNames": [
        "org.apache.logging{/,}**",
        "org.slf4j{/,}**"
      ],
      "groupName": "Logging",
      "groupSlug": "logging"
    }
  ]
}
